
<!DOCTYPE html>
<html>
<head>
<title>To-Do List</title>
<style>
body{font-family:Arial;text-align:center;margin:40px;background:#f2f2f2;color:black}
main{background:white;color:black;padding:30px;max-width:350px;margin:auto;border-radius:8px}
input{padding:8px;width:55%}
button{padding:8px;cursor:pointer}
li{display:flex;justify-content:space-between;align-items:center;margin:10px 0;padding:8px;background:#eee;color:black}
.completed{text-decoration:line-through;color:gray}
.dark{background:black;color:white}
.dark main{background:#333;color:white}
.dark li{background:#555;color:white}
</style>
</head>
<body>

<main>
<h2>My To-Do List</h2>
<input id="taskInput" placeholder="Enter task">
<button id="addBtn">Add</button>
<ul id="taskList"></ul>
<button onclick="toggleTheme()">Change Theme</button>
</main>

<script>
const input=document.getElementById('taskInput'),
list=document.getElementById('taskList');

function addTask(){
 if(!input.value.trim()) return alert('Enter a task');

 let li=document.createElement('li'),
 text=document.createElement('span'),
 edit=document.createElement('button'),
 del=document.createElement('button');

 text.textContent=input.value.trim();
 edit.textContent='Edit';
 del.textContent='Delete';

 li.append(text,edit,del);
 list.appendChild(li);
 input.value='';

 li.onclick=e=>{
  if(e.target===text) li.classList.toggle('completed');
 };

 edit.onclick=e=>{
  e.stopPropagation();
  let value=prompt('Edit task:',text.textContent);
  if(value?.trim()) text.textContent=value.trim();
 };

 del.onclick=e=>{
  e.stopPropagation();
  li.parentElement.removeChild(li);
 };
}

document.getElementById('addBtn').onclick=addTask;
input.onkeypress=e=>{
 if(e.key==='Enter') addTask();
};

function toggleTheme(){
 document.body.classList.toggle('dark');
}
</script>

</body>
</html>
